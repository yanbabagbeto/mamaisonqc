# Copy to .env.local and adjust. No secret is required to run the app locally.
# SQLite database produced by `npm run db:build`.
DATABASE_URL="./data/mamaisonqc.db"
# Public origin used in sitemap/robots/metadata.
SITE_URL="http://localhost:3000"
# MERN Adresses Québec geocoder (CC-BY 4.0). Override only if the endpoint changes.
GEOCODER_URL="https://servicescarto.mrnf.gouv.qc.ca/pes/rest/services/Territoire/Adresse_Geocodage/GeocodeServer"
# Set to 1 to disable outbound geocoder calls (tests / offline demo).
# GEOCODER_OFFLINE=1
