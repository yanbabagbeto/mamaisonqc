# Base URL of the MaMaisonQC web API (it serves the JSON endpoints and owns the database).
# Copy this file to `.env` (git-ignored) or pass the variable inline:
#   EXPO_PUBLIC_API_URL=http://localhost:3000 npx expo start
#
# iOS simulator / web: http://localhost:3000 (the Mac itself)
# Android emulator:    http://10.0.2.2:3000 (the host from inside the emulator)
# Physical phone:      http://<Mac LAN IP>:3000 (e.g. http://192.168.1.42:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
